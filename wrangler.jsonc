// Cloudflare Worker for The Car Archive (currently served at brandsmodels.com; the final domain is undecided).
// The public base URL used in canonical links and the sitemap comes from site.config.json or the SITE_URL build variable.
// `wrangler deploy` (and Workers Builds) first runs the build below, which writes the whole public site to public/.
// Only public/ is uploaded as static assets; the Worker script runs first only for /api/* and /admin.
{
  "name": "brandsmodels",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Created in the Cloudflare dashboard. Apply the schema with
  // `npx wrangler d1 migrations apply brandsmodels --remote` (or run migrations/*.sql in order in the D1 console).
  // 0002 adds the car_* tables; the fashion-era tables from 0001 stay untouched and unused.
  "d1_databases": [
    { "binding": "DB", "database_name": "brandsmodels", "database_id": "5be31ace-c6ee-4c01-936c-72af74be2180", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
