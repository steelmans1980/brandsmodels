// Cloudflare Worker for brandsmodels.com.
// `wrangler deploy` (and Workers Builds) first runs the build below, which writes the whole public site to public/.
// Only public/ is uploaded as static assets; the Worker script runs first only for /api/* and /admin.
{
  "name": "brandsmodels",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Create once with `npx wrangler d1 create brandsmodels`, put its id here, then
  // `npx wrangler d1 migrations apply brandsmodels --remote`. Until then a deploy fails instead of shipping a broken API.
  "d1_databases": [
    { "binding": "DB", "database_name": "brandsmodels", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
